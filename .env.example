# Web
CONTENT_API_BASE_URL=http://127.0.0.1:3001
CONTENT_API_READ_TOKEN=
WEB_CONTENT_SOURCE=filesystem
WEB_RENDER_MODE=static-export
# runtime-isr 默认且当前仅支持单副本；多副本必须先接共享 Cache Handler。
WEB_RUNTIME_REPLICAS=1
SITE_URL=http://127.0.0.1:3000
BASE_PATH=

# PostgreSQL (Phase 1+)
DATABASE_URL=postgresql://cblog:cblog@127.0.0.1:5432/cblog

# One-time migration tooling (Phase 2; never used by Web runtime)
# Must exactly equal hostname:port/database from DATABASE_URL before apply.
CBLOG_MIGRATION_CONFIRM_TARGET=
# Prefer an absolute path outside the Git worktree; blank uses repo data/migration-assets.
MIGRATION_ASSET_DIR=
MIGRATION_ASSET_PUBLIC_BASE_URL=http://127.0.0.1:3001/assets
# filesystem 用于本地/staging；生产冻结迁移使用 s3 并复用下方 OBJECT_STORAGE_*。
MIGRATION_ASSET_STORE=filesystem

# Phase 7 PostgreSQL backup/restore drill safety confirmations.
CBLOG_BACKUP_CONFIRM_TARGET=
RESTORE_DATABASE_URL=
CBLOG_RESTORE_CONFIRM_TARGET=

# Admin authentication (Phase 3+; GitHub OAuth via Auth.js)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Test-only identity provider for local/CI contract tests. NEVER set in real deployments.
AUTH_TEST_MODE=
# Set true only behind a trusted reverse proxy in self-hosted production.
AUTH_TRUST_HOST=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_ALLOWED_GITHUB_ID=

# S3-compatible object storage (Phase 2/3+)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cblog
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/cblog
# MinIO and most self-hosted S3 need path-style; AWS S3 can set false.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Signed publication events (Phase 5/6+)
REVALIDATION_WEBHOOK_URL=http://127.0.0.1:3000/api/revalidate
REVALIDATION_ACTIVE_KEY_ID=local-v1
REVALIDATION_ACTIVE_SECRET=
REVALIDATION_PREVIOUS_KEY_ID=
REVALIDATION_PREVIOUS_SECRET=

# Publication delivery. Valid combinations:
# static-export -> github-dispatch | generic-build-hook
# runtime-isr  -> revalidation-webhook
PUBLICATION_DRIVER=github-dispatch
GITHUB_REPOSITORY=
GITHUB_DISPATCH_EVENT=cblog-content-published
GITHUB_DISPATCH_TOKEN=
# GitHub API 基址；仅测试需要指向 mock stub，生产留空即默认 https://api.github.com
GITHUB_API_BASE_URL=
GENERIC_BUILD_HOOK_URL=
GENERIC_BUILD_HOOK_BEARER_TOKEN=
DEPLOY_CALLBACK_URL=
DEPLOY_CALLBACK_SECRET=

# Outbox worker (Phase 6)
# 静态驱动 debounce 窗口（秒）：从最老 pending 起等待后一次 claim；running 批次不再接收新事件
OUTBOX_BATCH_WINDOW_SECONDS=120
# 单事件最大投递尝试次数，耗尽置 failed，由发布页 retry 复位
OUTBOX_MAX_ATTEMPTS=8
# worker 主循环轮询间隔（毫秒）
OUTBOX_POLL_INTERVAL_MS=5000
# delivering 租约（秒）：worker 崩溃后超时回收回 pending，attempt 不增
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
# 下游单请求超时（毫秒），必须严格小于 delivering 租约对应毫秒数
OUTBOX_REQUEST_TIMEOUT_MS=15000
# 静态部署巡检（秒）：running 超时置 timed_out；queued 使用 claim 租约回收
OUTBOX_DEPLOY_TIMEOUT_SECONDS=1800
# webhook 投递成功后的 best-effort 预热基址（可选，留空跳过预热）
PUBLIC_WEB_BASE_URL=

# Migration-only flags; production switches once in Phase 7 and never dual-writes.
ADMIN_STORAGE=filesystem
PUBLIC_CONTENT_API_ENABLED=false
GIT_PUBLISH_ENABLED=true
