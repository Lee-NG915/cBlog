{
  "name": "cblog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @cblog/web dev",
    "dev:admin": "pnpm --filter @cblog/admin dev",
    "build": "pnpm --filter @cblog/core content:check && pnpm --filter @cblog/web build",
    "lint": "pnpm --filter @cblog/web lint",
    "test": "pnpm --filter @cblog/core test",
    "db:migrate": "pnpm --filter @cblog/core db:migrate",
    "db:pg:generate": "pnpm --filter @cblog/core db:pg:generate",
    "db:pg:migrate": "pnpm --filter @cblog/core db:pg:migrate",
    "test:postgres": "pnpm --filter @cblog/core test:postgres",
    "content:migrate:plan": "pnpm --filter @cblog/core content:migrate:plan",
    "content:migrate:apply": "pnpm --filter @cblog/core content:migrate:apply",
    "content:migrate:verify": "pnpm --filter @cblog/core content:migrate:verify",
    "content:export": "pnpm --filter @cblog/core content:export",
    "test:migration": "pnpm --filter @cblog/core test:migration",
    "content:import": "pnpm --filter @cblog/core content:import",
    "content:check": "pnpm --filter @cblog/core content:check",
    "preview": "python3 -m http.server 4173 -d apps/web/out",
    "parity:snapshot": "node scripts/parity-snapshot.mjs snapshot apps/web/out",
    "parity:compare": "node scripts/parity-snapshot.mjs compare"
  }
}
