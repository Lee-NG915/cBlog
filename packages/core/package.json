{
  "name": "@cblog/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown/render.ts",
    "./postgres": "./src/postgres.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:pg:generate": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:pg:migrate": "tsx src/cli/migrate-postgres.ts",
    "content:migrate:plan": "tsx src/cli/content-migrate.ts plan",
    "content:migrate:apply": "tsx src/cli/content-migrate.ts apply",
    "content:migrate:verify": "tsx src/cli/content-migrate.ts verify",
    "content:export": "tsx src/cli/content-export.ts",
    "content:import": "tsx src/cli/import.ts",
    "content:check": "tsx src/cli/check.ts",
    "content:migrate-collections": "tsx src/cli/migrate-collections.ts",
    "test": "vitest run",
    "test:postgres": "vitest run src/db/postgres/postgres.integration.test.ts",
    "test:migration": "vitest run src/migration/migration.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.38.3",
    "gray-matter": "^4.0.3",
    "postgres": "^3.4.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.10.6",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
